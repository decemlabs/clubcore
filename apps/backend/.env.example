# Async PostgreSQL DSN. Phase 3 docker-compose provides this Postgres at localhost:5432.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/clubcore

# Phase 62 D-62-03 — Email FROM address override.
# Falls back to SPORTZAL_EMAIL_FROM (deprecated, v1.11 removal) and then
# to the hardcoded default "noreply@mail.sportzal.ru" if unset.
# CLUBCORE_EMAIL_FROM=noreply@mail.sportzal.ru

# Redis (used by ARQ workers and any future caching).
REDIS_URL=redis://localhost:6379/0

# Runtime environment: 'dev' | 'staging' | 'prod'.
# Drives structlog renderer (Console for dev, JSON for staging/prod) and FastAPI docs visibility.
ENVIRONMENT=dev

# Verbose mode (echoes SQL, enables /docs).
DEBUG=true

# Placeholder secret. Auth lands in Phase C+ — value is intentionally non-secret in dev.
SECRET_KEY=change-me-dev-only-not-secret-32chr

# Access JWT TTL (seconds). 900 = 15 min.
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token TTL (seconds). 2592000 = 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000

# PyJWT clock leeway (seconds) for cross-container drift.
JWT_CLOCK_LEEWAY_SECONDS=30

# Set Secure cookie attribute. dev=false (local http); prod startup ASSERTS true (Phase 5).
COOKIE_SECURE=false

# Refresh-rotation reuse-window in seconds. D-13 (Phase 5 AUTH-06).
# Two parallel /auth/refresh calls within this window return the same new pair (idempotent).
REFRESH_REUSE_WINDOW_SECONDS=5

# Seed owner credentials. Consumed by `uv run python -m scripts.seed_demo_data` (D-25).
# Leave empty in .env; set explicitly in operator shell when seeding.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Phase 7 — Telegram OTP channel (D-10, D-03).
# Defaults are intentional placeholders so fresh-clone `docker-compose up`
# + admin-web dev with VITE_API_MODE=http boots without bot credentials.
# The telegram-bot worker REFUSES to start while these placeholders are in
# effect — set real values from @BotFather before running the bot.
TELEGRAM_BOT_TOKEN=placeholder-telegram-bot-token-not-real
TELEGRAM_BOT_USERNAME=placeholder_bot
OTP_DEEP_LINK_TTL_SECONDS=600
OTP_CODE_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Phase 71 WR-06 — dev-only client-OTP pin opt-in. When true (AND ENVIRONMENT=dev)
# the client OTP is pinned to "111111" and the raw code is logged at WARNING so
# local UAT can sign in without a real Telegram chat. MUST stay false outside dev —
# Settings refuses to start if true while ENVIRONMENT is staging/prod. Default false.
# Set DEV_OTP_PIN_ENABLED=true locally to use the seed_dev_client UAT login.
DEV_OTP_PIN_ENABLED=false

# Optional — consumed by `uv run python -m scripts.seed_demo_data` (D-03).
# Lowercase Telegram username without leading `@`. Idempotently writes
# users.telegram_username for the seeded owner. Empty = skip the bind step.
TELEGRAM_OWNER_USERNAME=

# Visits — gym hours window (Europe/Moscow)
GYM_HOURS_START=07:00
GYM_HOURS_END=23:00

# Phase 47 — ЮKassa online payments + 54-ФЗ fiscal receipts (INFRA-36, D-47-09).
# Defaults are intentional placeholders so fresh-clone `docker-compose up` and
# admin-web dev with VITE_API_MODE=http boots without ЮKassa credentials.
# YOOKASSA_SANDBOX=true bypasses real-credential validation AND the IP allowlist
# in verify_yookassa_ip (D-47-07). Replace YOOKASSA_SHOP_ID + YOOKASSA_SECRET_KEY
# with real values from your ЮKassa merchant dashboard before running in
# non-sandbox mode. No real credentials in git (D-47-09).
YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET_KEY=placeholder-secret-key-not-real
YOOKASSA_RETURN_URL=https://example.com/yookassa/return
# CR-01/CR-02 fix (Phase 71): PWA return base URL — set to the real PWA /payment/return
# origin in staging/prod. Staff path uses YOOKASSA_RETURN_URL (unchanged); client path
# uses this base + ?payment_id={uuid} so PaymentReturnScreen can poll the status endpoint.
YOOKASSA_CLIENT_RETURN_URL=https://pwa.example.com/payment/return
YOOKASSA_TAX_SYSTEM_CODE=2
YOOKASSA_DEFAULT_VAT_CODE=1
YOOKASSA_SANDBOX=true

# Phase 92 ATT-01 — S3-compatible object storage (photo attachments).
# Local dev defaults point at the docker SeaweedFS S3 service (docker-compose.yml).
# Override all four vars with real provider values (e.g. Yandex Object Storage)
# for staging/prod. No real credentials in git.
# S3_ENDPOINT_URL=http://localhost:8333
# S3_BUCKET=clubcore-local
# S3_ACCESS_KEY_ID=dev-access-key
# S3_SECRET_ACCESS_KEY=dev-secret-key
# S3_REGION=ru-central1
