[importlinter]
root_packages =
    app

[importlinter:contract:core-not-depend-on-modules]
name = core must not import modules
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules

[importlinter:contract:modules-independent]
name = modules cannot import each other
type = independence
modules =
    app.modules.auth
    app.modules.clients
    app.modules.memberships
    app.modules.visits
    app.modules.trainers
    app.modules.schedule
    app.modules.bookings
    app.modules.billing
    app.modules.notifications
    app.modules.payments
    app.modules.pt_packages
    app.modules.pt_sessions
    app.modules.users
ignore_imports =
    # Phase 43 USERS-02 / D-43-13 / D-43-19 — Phase 41 0025 password_reset_tokens
    # row (purpose='invitation') is shared infrastructure consumed by both the
    # auth (RESET-02) and users (USERS-02) modules. The ORM model lives under
    # app.modules.auth.password_reset_token_model as the canonical bedrock; the
    # users repository (USERS-02 invitation-token CRUD) is the legitimate
    # second consumer. Future tighten: hoist the model to app.core.models
    # alongside User (DEFER-43-shim) — at that point this ignore is removed.
    app.modules.users.repository -> app.modules.auth.password_reset_token_model
    # Phase 44 RESET-04 / D-44-18 / D-44-21 — POST /users/invitations/accept is
    # an anonymous endpoint that delegates atomic-consume + UPDATE-only password
    # set to auth bedrock (password_reset_service), then issues session cookies
    # via the SAME issue_tokens + issue_session_cookies sequence that /auth/login
    # uses. The endpoint MUST live in users/router.py because the URL space is
    # /users/invitations/* (Phase 43 surface), but the auth-bedrock primitives
    # (User ORM, LoginResponse/UserPublic schemas, issue_tokens helper) cannot
    # be duplicated without cookie-issuance drift. Future tighten: hoist
    # User + LoginResponse + UserPublic + issue_tokens into app.core to
    # eliminate the auth-coupling (DEFER-44-cookies-hoist).
    app.modules.users.router -> app.modules.auth.password_reset_service
    app.modules.users.router -> app.modules.auth.service
    app.modules.users.router -> app.modules.auth.schemas
    app.modules.users.router -> app.modules.auth.models

[importlinter:contract:integrations-not-depend-on-modules]
name = integrations must not import modules
type = forbidden
source_modules =
    app.integrations
forbidden_modules =
    app.modules
ignore_imports =
    app.integrations.email.dispatcher -> app.modules.auth.email_templates
    app.integrations.email.dispatcher -> app.modules.users.email_templates
