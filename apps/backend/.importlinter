[importlinter]
root_packages =
    app

[importlinter:contract:core-not-depend-on-modules]
name = core must not import modules
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules

[importlinter:contract:modules-independent]
name = modules cannot import each other
type = independence
modules =
    app.modules.auth
    app.modules.clients
    app.modules.memberships
    app.modules.visits
    app.modules.trainers
    app.modules.schedule
    app.modules.bookings
    app.modules.billing
    app.modules.notifications
    app.modules.online_payments
    app.modules.payments
    app.modules.pt_packages
    app.modules.pt_sessions
    app.modules.users
    # Phase 47 INFRA-40 — Option A deferral closed by Phase 49 D-49-02
    # (2026-05-22): `app.modules.online_payments` is registered above, the
    # 3 INFRA-40 ignore edges + the email dispatcher edge resolve to matched
    # imports, and the contract is fully active.
ignore_imports =
    # Phase 43 USERS-02 / D-43-13 / D-43-19 — Phase 41 0025 password_reset_tokens
    # row (purpose='invitation') is shared infrastructure consumed by both the
    # auth (RESET-02) and users (USERS-02) modules. The ORM model lives under
    # app.modules.auth.password_reset_token_model as the canonical bedrock; the
    # users repository (USERS-02 invitation-token CRUD) is the legitimate
    # second consumer. Future tighten: hoist the model to app.core.models
    # alongside User (DEFER-43-shim) — at that point this ignore is removed.
    app.modules.users.repository -> app.modules.auth.password_reset_token_model
    # Phase 44 RESET-04 / D-44-18 / D-44-21 — POST /users/invitations/accept is
    # an anonymous endpoint that delegates atomic-consume + UPDATE-only password
    # set to auth bedrock (password_reset_service), then issues session cookies
    # via the SAME issue_tokens + issue_session_cookies sequence that /auth/login
    # uses. The endpoint MUST live in users/router.py because the URL space is
    # /users/invitations/* (Phase 43 surface), but the auth-bedrock primitives
    # (User ORM, LoginResponse/UserPublic schemas, issue_tokens helper) cannot
    # be duplicated without cookie-issuance drift. Future tighten: hoist
    # User + LoginResponse + UserPublic + issue_tokens into app.core to
    # eliminate the auth-coupling (DEFER-44-cookies-hoist).
    app.modules.users.router -> app.modules.auth.password_reset_service
    app.modules.users.router -> app.modules.auth.service
    app.modules.users.router -> app.modules.auth.schemas
    app.modules.users.router -> app.modules.auth.models
    # Phase 45 NOTIFY-11/12/13 (Plan 45-09) — orchestrator-site receipt-email
    # fanout in memberships/service.py needs (a) the PaymentReceipt ORM row
    # to write the idempotency ledger, and (b) format_actor_display to compose
    # the operator display name into the receipt render context. Both are
    # narrowly scoped to memberships/service.py only; the broader
    # modules-independent invariant remains in force for every other file.
    # Per PATTERNS.md correction #4 the fanout cannot live in payments
    # (caller-owns-txn) and the helper must be single-canonical-path
    # (WARNING-4) — so module crosses are the only path.
    app.modules.memberships.service -> app.modules.payments.models
    app.modules.memberships.service -> app.modules.users.display
    # Phase 45 NOTIFY-11/12/13 (Plan 45-10) — same rationale as Plan 45-09
    # memberships above, mirrored byte-for-byte for pt_packages/service.py.
    # The orchestrator-site receipt-email fanout in create_pt_package +
    # refund_pt_package needs (a) PaymentReceipt ORM row + (b)
    # format_actor_display. Both narrowly scoped to pt_packages/service.py.
    app.modules.pt_packages.service -> app.modules.payments.models
    app.modules.pt_packages.service -> app.modules.users.display
    # Phase 47 INFRA-40 — preemptive ignores for v1.7 online-payments module.
    # The module body ships in Phase 49; contract entries land now per INFRA-15
    # discipline so misplaced imports fail fast at import-linter time. Each
    # cross-module edge is narrowly scoped to the online_payments service layer
    # and mirrors the Phase 45 NOTIFY-11/12/13 precedent.
    #   - record_payment(method='online') needs payments.models for the
    #     ledger-row return type (mirrors memberships.service → payments.models).
    #   - users.display for the operator display name in receipt context
    #     (mirrors memberships.service → users.display).
    app.modules.online_payments.service -> app.modules.payments.models
    app.modules.online_payments.service -> app.modules.users.display
    # Phase 49 PAY-06 / D-49-13 — clients.email gate read; service-layer
    # scoped; no widening to repository. Mirrors Phase 45 NOTIFY-11/12/13
    # narrow-scope precedent at lines 63-80 above. BLOCKER #3 / D-49-03:
    # NO additional cross-module ignores beyond clients models — Plan 49-03
    # reads other subject tables via raw SQL `text()` SELECT (no ORM import).
    app.modules.online_payments.service -> app.modules.clients.models
# Phase 47 INFRA-40 — `warn` (not the default `error`) so the 3 preemptive
# online_payments edges above do not fail the build before Phase 49 ships the
# module body. Once 49 lands and the imports materialise, the warnings clear
# automatically; if a pre-existing edge ever stops matching, a CI warning
# still surfaces. Discipline: never raise this to `none` — the warning is the
# signal that the contract layer and the code are drifting.
unmatched_ignore_imports_alerting = warn

[importlinter:contract:integrations-not-depend-on-modules]
name = integrations must not import modules
type = forbidden
source_modules =
    app.integrations
forbidden_modules =
    app.modules
ignore_imports =
    app.integrations.email.dispatcher -> app.modules.auth.email_templates
    app.integrations.email.dispatcher -> app.modules.users.email_templates
    # Phase 45 NOTIFY-08 / NOTIFY-10 / NOTIFY-12 (Plan 45-06b) — extend the
    # walker's per-module template registries (Plans 45-04 memberships,
    # 45-05 bookings, 45-06 payments). Overrides D-45-24's "zero
    # .importlinter changes" claim per PATTERNS.md correction #3 — grimp
    # parses function-scope imports, so each new registry needs its own
    # allowlist entry. The narrow source -> target shape keeps the
    # exception bounded to dispatcher.py importing template-only modules.
    app.integrations.email.dispatcher -> app.modules.memberships.email_templates
    app.integrations.email.dispatcher -> app.modules.bookings.email_templates
    app.integrations.email.dispatcher -> app.modules.payments.email_templates
    # Phase 47 INFRA-40 — central email dispatcher walker must resolve v1.7
    # online-payment template IDs (mirrors the Phase 45 dispatcher → modules
    # email_templates allowlist).
    app.integrations.email.dispatcher -> app.modules.online_payments.email_templates
# Phase 47 INFRA-40 — see modules-independent rationale; `warn` keeps the
# preemptive online_payments.email_templates edge green before Phase 52 ships
# the template module body, without losing the unused-ignore signal for the
# pre-existing 5 dispatcher entries.
unmatched_ignore_imports_alerting = warn
