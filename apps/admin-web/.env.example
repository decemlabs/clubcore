# Frontend API mode — controls whether services use mock/ or http/ implementations.
# Allowed values: mock | http
# Default: mock (in-memory mock services, no backend needed)
VITE_API_MODE=mock

# Backend base URL (used by @sportzal/api-client when VITE_API_MODE=http).
# Default: http://localhost:8000 (FastAPI dev server)
VITE_API_BASE_URL=http://localhost:8000
