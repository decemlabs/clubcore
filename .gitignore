# Root-level ignores for the clubcore monorepo.
# Per-app rules live in apps/*/.gitignore — keep this file for cross-cutting noise only.

# macOS Finder metadata
.DS_Store

# Editor / IDE
*.swp
*.swo
*~
.idea/
.vscode/

# Root-level dependency caches (per-app caches are covered by the per-app .gitignore files)
node_modules/

# Claude Code per-project installation (GSD agents/hooks/settings — user-specific, auto-generated)
.claude/

# Logs
*.log
pnpm-debug.log*
yarn-debug.log*
npm-debug.log*
.planning/milestones/v1.3-verification-evidence/

# Redocly static doc-site build output (D-11-DOCS-PRIVATE — private artifact, never published)
.docs-site/

# Newman intermediate base collection (regenerated by `pnpm postman:gen`; not a committed artifact)
tools/newman/base-collection.json

# Local runtime artifacts — never commit (.kube/config holds k8s credentials)
.instance/
.kube/
