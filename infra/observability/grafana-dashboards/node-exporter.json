{
  "title": "Node Exporter Full — clubcore",
  "description": "Import wrapper for grafana.com dashboard ID 1860 (Node Exporter Full by rfmoz). OBS-04.",
  "tags": ["node-exporter", "system", "clubcore", "obs-04"],
  "schemaVersion": 39,
  "version": 1,
  "__gsd_import_instructions": {
    "comment": "This is a curated import wrapper. Load the full dashboard via Grafana UI or ConfigMap import.",
    "grafana_com_id": 1860,
    "grafana_com_url": "https://grafana.com/grafana/dashboards/1860",
    "import_method": "Grafana UI → Dashboards → Import → Enter ID 1860 → select Prometheus datasource",
    "revision": "latest"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus datasource"
      },
      {
        "name": "node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(node_uname_info, nodename)",
        "label": "Node",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Import Instructions",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "## Node Exporter Full Dashboard (grafana.com ID: 1860)\n\nThis panel is a placeholder. Load the full dashboard:\n1. Grafana → Dashboards → Import\n2. Enter ID **1860**\n3. Select your Prometheus datasource\n\nAlternatively, use the ConfigMap import path described in `README.md`."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU Usage",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memory Usage",
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "Mem %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Disk Usage (root)",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "Disk %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    }
  ]
}
